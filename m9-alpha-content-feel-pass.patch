--- /dev/null
+++ b/crates/client/src/audio.rs
@@ -0,0 +1,47 @@
+//! Placeholder audio cues (plan §14 M9: "land placeholder audio cues").
+//!
+//! The Alpha judges system properties, not content volume. This stub provides
+//! the presentation seam for audio; post-Alpha this will hand cues to a mixer
+//! (cpal + own mixer, per plan §92).
+
+use pandemonium_sim_api::Event;
+
+/// A placeholder audio cue dispatcher.
+pub struct AudioStub;
+
+impl AudioStub {
+    pub fn new() -> Self {
+        Self
+    }
+
+    /// Process simulation events and emit placeholder audio cues.
+    pub fn on_events(&self, events: &[Event]) {
+        for event in events {
+            match event {
+                Event::Spawned { .. } => self.cue("sfx_spawn"),
+                Event::Died { .. } => self.cue("sfx_die"),
+                Event::AttackHit { .. } => self.cue("sfx_attack"),
+                Event::ProductionStarted { .. } => self.cue("sfx_produce_start"),
+                Event::ProductionCompleted { .. } => self.cue("sfx_produce_done"),
+                Event::ConstructionStarted { .. } => self.cue("sfx_build_start"),
+                Event::ConstructionCompleted { .. } => self.cue("sfx_build_done"),
+                Event::ResourceDelivered { .. } => self.cue("sfx_resource"),
+                Event::NodeDepleted { .. } => self.cue("sfx_depleted"),
+                Event::CommandRejected { .. } => self.cue("sfx_reject"),
+                Event::MoveFailed { .. } => self.cue("sfx_stuck"),
+                Event::MatchEnded { winner } => {
+                    if *winner == pandemonium_sim_api::PlayerId::NEUTRAL {
+                        self.cue("sfx_defeat");
+                    } else {
+                        self.cue("sfx_victory");
+                    }
+                }
+            }
+        }
+    }
+
+    fn cue(&self, _name: &str) {
+        // Placeholder: in a real build, this would queue `_name` to a mixer.
+        // For the Alpha, the seam exists so the feel-pass can verify the flow.
+    }
+}
