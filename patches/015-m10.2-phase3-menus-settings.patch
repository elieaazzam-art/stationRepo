From 3b68e59419a244991795840fd426b77ad7e67f22 Mon Sep 17 00:00:00 2001
From: elieaazzam-art <elieaazzam-art@users.noreply.github.com>
Date: Wed, 7 Oct 2026 21:32:24 +0000
Subject: [PATCH 07/16] fix(client): re-bind the camera group for the entity
 draw when no decals exist (PLAN-M10.2 3.2)

The fog pass leaves the fog bind group in slot 0; the decal pass between
it and the entity draw restores the camera group, but it is skipped when
there is nothing to draw - and a menu frame with zero entities is
exactly that (the latent path mutual destruction would also have hit).
wgpu validates the bind group even for a zero-instance draw; the first
menu-first Xvfb smoke caught it live.
---
 crates/client/src/render.rs | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/crates/client/src/render.rs b/crates/client/src/render.rs
index 08aabdb..165c9ff 100644
--- a/crates/client/src/render.rs
+++ b/crates/client/src/render.rs
@@ -2068,6 +2068,13 @@ impl Renderer for WgpuRenderer {
                 }
             }
             pass.set_pipeline(&self.entity_pipeline);
+            // Re-bind the camera group for the entity draw: the fog pass
+            // leaves the *fog* group in slot 0, and the decal pass between
+            // them (which restores the camera group) is skipped when there
+            // is nothing to draw — a menu frame with zero entities hit
+            // exactly that (PLAN-M10.2 §3.2's menu-first world). wgpu
+            // validates the bind group even for a zero-instance draw.
+            pass.set_bind_group(0, &self.camera_bind_group, &[]);
             pass.set_vertex_buffer(0, self.entity_vertex_buf.slice(..));
             pass.set_vertex_buffer(1, self.entity_instance_buf.slice(..));
             pass.draw(0..36, 0..needed.min(self.entity_instance_capacity) as u32);
