+        let mut camera = camera();
+        camera.clamp_distance_to(50.0, 20.0); // "min" above "max"
+        assert!(
+            camera.distance() >= 20.0 && camera.distance() <= 50.0,
+            "the pair clamps as (20, 50), never panics"
+        );
+    }
