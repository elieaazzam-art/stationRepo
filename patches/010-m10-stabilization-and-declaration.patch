+        for step in 0..=steps {
+            let t = step as f32 / steps as f32;
+            let x = x0 + (x1 - x0) * t;
+            let y = y0 + (y1 - y0) * t;
+            quads.push(atlas.solid_rect(
+                x - DOT * 0.5,
+                y - DOT * 0.5,
+                DOT,
+                DOT,
+                [1.0, 1.0, 1.0, 0.85],
