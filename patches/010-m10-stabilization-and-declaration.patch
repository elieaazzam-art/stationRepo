+# match crashes).
+
+on:
+  schedule:
+    - cron: "0 3 * * *" # 03:00 UTC daily
+  workflow_dispatch: {} # manual trigger for on-demand sweeps
+
+env:
+  CARGO_TERM_COLOR: always
+
+jobs:
