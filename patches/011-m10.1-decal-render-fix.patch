From f51543fecc722c36eed5379a91e755055dd9890e Mon Sep 17 00:00:00 2001
From: Elie Aazzam <elieaazzam-art@users.noreply.github.com>
Date: Tue, 6 Oct 2026 05:30:24 +0000
Subject: [PATCH] fix(client): bind the decal instance buffer to vertex slot 1
 before drawing
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The decal pipeline declares two vertex buffer slots: slot 0 for the
quad/ring geometry and slot 1 for the per-instance DecalInstance data
(position, scale, color) at instance step mode. The decal draw block in
WgpuRenderer::render_frame uploaded the instance data with
queue.write_buffer but never bound that buffer to the pass, so the
first decal draw reached wgpu's validation with the pipeline's
instance slot unset:

    wgpu error: Validation Error
    In a CommandEncoder
      In a draw command, kind: Draw
        Currently set RenderPipeline with 'decal pipeline' label
        requires vertex buffer 1 to be set

The crash is deterministic on the first frame because build_shadows
gives every entity a blob shadow and the initial map starts with
entities. The follow-up "Trying to destroy a SurfaceAcquireSemaphores
that is still in use by a SurfaceTexture" panic is a teardown artifact
of the first panic unwinding before the acquired surface texture was
presented; it disappears with the primary fix (A/B runs under Xvfb +
lavapipe: the unfixed build aborts with both panics, the fixed build
presents 600 frames and exits cleanly with no wgpu errors).

The fix binds slot 1 once inside the existing !decals.is_empty()
block, after set_pipeline/set_bind_group and before both conditional
draws: quads (shadows + placement ghost) and rings (selection) draw
from the same instance buffer in two instance ranges, so one binding
covers both; the per-geometry slot-0 bindings stay where they were.

Regression test: CPU-side tests cannot reach render-pass validation
(the GPU path only runs with a display, as the shader-parse test's
doc already records), so the draw state is machine-checked the same
hermetic way this repo pins its other laws (architecture_law.rs-style
source scanning): every instanced pipeline (decal + entity) must bind
its instance buffer to slot 1 between its set_pipeline and its first
draw, scanning only the rendering code (before the first test module)
with line comments stripped so a commented-out binding cannot satisfy
the check. The test fails on the unfixed source and passes on the
fixed one (verified both ways).

Verified: cargo fmt --check, clippy -D warnings, the full workspace
suite (354 tests), the replay round-trip (A2), and the determinism
golden — headless --seed 7 --ticks 300 still ends at
0x9d5ba9b565060336 (the change is client-rendering-only).
---
 crates/client/src/render.rs | 53 +++++++++++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/crates/client/src/render.rs b/crates/client/src/render.rs
index 5651910..57b4c0a 100644
--- a/crates/client/src/render.rs
+++ b/crates/client/src/render.rs
@@ -2055,6 +2055,11 @@ impl Renderer for WgpuRenderer {
                 );
                 pass.set_pipeline(&self.decal_pipeline);
                 pass.set_bind_group(0, &self.camera_bind_group, &[]);
+                // Slot 1 carries the per-instance data for both decal draws
+                // (quads and rings share one instance buffer): without this
+                // binding the pass draws with the pipeline's instance slot
+                // unset and wgpu's validation rejects the very first draw.
+                pass.set_vertex_buffer(1, self.decal_instance_buf.slice(..));
                 if shadow_count + ghost_count > 0 {
                     pass.set_vertex_buffer(0, self.quad_vertex_buf.slice(..));
                     pass.draw(0..self.quad_vertex_count, 0..(shadow_count + ghost_count));
@@ -2124,6 +2129,54 @@ mod tests {
             }
         }
     }
+
+    /// The instanced pipelines (decal + entity) draw with two vertex buffer
+    /// slots: slot 0 geometry, slot 1 per-instance data. wgpu validates slot
+    /// bindings at draw time, so a pipeline left with its instance slot unset
+    /// is a first-frame GPU validation panic — the render pass only runs on a
+    /// machine with a display, so CPU-side tests cannot reach it. As far as
+    /// this environment allows (the same bargain as the shader-parse test
+    /// above), the draw state is machine-checked: each instanced pipeline
+    /// must bind its instance buffer to slot 1 between its `set_pipeline`
+    /// and its first `draw`. `queue.write_buffer` alone does not bind.
+    #[test]
+    fn every_instanced_pipeline_binds_its_instance_slot_before_drawing() {
+        let source = std::fs::read_to_string(concat!(env!("CARGO_MANIFEST_DIR"), "/src/render.rs"))
+            .expect("render.rs sits at the crate's src/");
+        // Scan only the rendering code — everything before the first test
+        // module, with line comments stripped — so this test's own literals
+        // and a commented-out binding cannot satisfy the law.
+        let cut = source.find("#[cfg(test)]").expect("a test module exists");
+        let code = source[..cut]
+            .lines()
+            .map(|line| &line[..line.find("//").unwrap_or(line.len())])
+            .collect::<Vec<_>>()
+            .join("\n");
+        for (pipeline, slot1) in [
+            (
+                "pass.set_pipeline(&self.decal_pipeline);",
+                "pass.set_vertex_buffer(1, self.decal_instance_buf.slice(..));",
+            ),
+            (
+                "pass.set_pipeline(&self.entity_pipeline);",
+                "pass.set_vertex_buffer(1, self.entity_instance_buf.slice(..));",
+            ),
+        ] {
+            let set_pipeline = code
+                .find(pipeline)
+                .unwrap_or_else(|| panic!("the {pipeline} call disappeared from render_frame"));
+            let bind = code[set_pipeline..].find(slot1).unwrap_or_else(|| {
+                panic!("{pipeline} draws without its instance buffer bound to slot 1")
+            });
+            let draw = code[set_pipeline..]
+                .find("pass.draw(")
+                .unwrap_or_else(|| panic!("{pipeline} never draws"));
+            assert!(
+                bind < draw,
+                "{pipeline} draws before binding its instance buffer to slot 1"
+            );
+        }
+    }
 }
 
 #[cfg(test)]
