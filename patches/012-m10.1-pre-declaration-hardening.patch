+/// The XXH64 accumulator round (spec step 2.2): `rotl64(acc + lane*P2, 31) * P1`.
+#[inline]
+fn round(acc: u64, lane: u64) -> u64 {
+    acc.wrapping_add(lane.wrapping_mul(PRIME2))
+        .rotate_left(31)
+        .wrapping_mul(PRIME1)
