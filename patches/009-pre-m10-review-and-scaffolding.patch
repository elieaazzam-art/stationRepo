+        assert_eq!(batch.vision, single.vision);
+        assert_eq!(batch.attack, single.attack);
+        // The ascending-id store invariant survives the batch.
+        let batch_entity_ids: Vec<EntityId> = batch.entities.iter().map(|e| e.id).collect();
+        assert!(
