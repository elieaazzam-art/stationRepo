+/// Two players, both humans (no AI in M6 — the soak harness will script
+/// both sides).
+fn two_player_setup(seed: u64) -> MatchSetup {
+    MatchSetup {
+        seed,
+        players: vec![
+            PlayerSetup {
+                player: PlayerId(0),
+                controller: ControllerKind::Human,
+            },
+            PlayerSetup {
+                player: PlayerId(1),
+                controller: ControllerKind::Human,
+            },
+        ],
+    }
+}
