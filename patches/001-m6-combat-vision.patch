+    let world = world_with_spawns(spawns.clone());
+    let script = vec![
+        Command {
+            issuer: PlayerId(0),
+            tick: 0,
+            seq: 1,
+            queue: false,
+            kind: CommandKind::Attack {
+                units: vec![EntityId(1)],
+                target: EntityId(2),
+            },
+        },
+        Command {
+            issuer: PlayerId(1),
+            tick: 0,
+            seq: 1,
+            queue: false,
+            kind: CommandKind::Attack {
+                units: vec![EntityId(2)],
+                target: EntityId(1),
+            },
+        },
+    ];
+    let (hash, survivors, events) = run_skirmish(&world, &setup, &spawns, &script, 200);
+    let hits = events
