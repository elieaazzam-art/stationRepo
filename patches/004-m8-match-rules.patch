+        PlayerId(1),
+        Box::new(ResignOnTickZero {
+            player: PlayerId(1),
+        }),
+    )];
+    let mut host = MatchHost::with_controllers(&world, setup, controllers);
+    let out = host.step_once();
+    assert!(
+        out.events.iter().any(|event| matches!(
+            event,
+            Event::MatchEnded {
+                winner: PlayerId(0)
+            }
+        )),
