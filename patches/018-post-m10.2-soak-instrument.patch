+        assert_eq!(report.matches, 2);
+        assert_eq!(report.crashed, 0);
+        assert!(report.crashes.is_empty());
+        assert_eq!(
+            report.resolved + report.mutual_destruction + report.unresolved,
+            2
+        );
+    }
