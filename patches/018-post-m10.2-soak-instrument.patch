+        assert_eq!(report.resolved, 2, "the sweep continued past the crash");
+        assert_eq!(report.end_ticks, vec![4321, 4321]);
+        assert_eq!(report.wins, vec![2, 0]);
+        assert_eq!(report.total_ticks, 8_642);
