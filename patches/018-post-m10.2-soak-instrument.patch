+        // short real matches over the shipped content stay green and the
+        // report's crash accounting lands on zero.
+        let cli = SoakCli {
+            matches: 2,
+            seed_base: 7,
+            ticks: 60,
+            content: repo_content(),
+            verbose: false,
+        };
